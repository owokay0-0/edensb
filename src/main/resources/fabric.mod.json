{
	"schemaVersion": 1,
	"id": "eden",
	"version": "${version}",
	"name": "Eden",
	"icon": "icon.png",
	"description": "A client-side Hypixel SkyBlock utility mod with dungeon helpers, HUD overlays, visual customization, render fixes, reminders, tooltip improvements.",
	"authors": [
		"owokay"
	],
	"contributors": [
		"NotEnoughUpdates (Moulconfig UI)"
	],
	"license": "GPL-3.0-only",
	"environment": "client",
  "entrypoints": {
    "client": [
      "dev.eden.client.EdenClient"
    ],
    "preLaunch": [
      "dev.eden.client.update.UpdatePreLaunch"
    ]
  },
  "mixins": [
    "eden.mixins.json"
  ],
	"accessWidener": "eden.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
